# .env.example - copy to .env and fill values (DO NOT commit .env to VCS)
# Usage:
#   copy .env.example .env
#   edit .env and provide real SMTP credentials

SMTP_SERVER=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=your_smtp_username
SMTP_PASSWORD=your_smtp_password
EMAIL_FROM=no-reply@example.com
PUBLIC_URL=https://your-public-tunnel-url.example.com

# Optional: if you use Mailtier, set SMTP_SERVER to smtp.mailtier.io and use your Mailtier username/password.
# Example:
# SMTP_SERVER=smtp.mailtier.io
# SMTP_PORT=587
# SMTP_USERNAME=mailtier_username
# SMTP_PASSWORD=mailtier_password

# Gmail example (free for low-volume sending, use app password / OAuth if 2FA is enabled):
# SMTP_SERVER=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=your-gmail-address@gmail.com
# SMTP_PASSWORD=your-app-password
# EMAIL_FROM=your-gmail-address@gmail.com

# Optional: any other env vars the app uses (e.g., SECRET_KEY)
# Supabase settings for production deployment
# SECRET_KEY=replace-with-your-secret
# DATABASE_URL=postgres://user:password@host:port/database
# SUPABASE_URL=https://your-supabase-project.supabase.co
# SUPABASE_KEY=your-supabase-key
# SUPABASE_BUCKET=attachments