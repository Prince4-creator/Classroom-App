# ========================================================
# Classroom App - Environment Configuration Template
# ========================================================
# SETUP: Copy this file to .env and fill in your values
# WARNING: Never commit .env to version control!
# ========================================================

# ========================================================
# CRITICAL: Flask & Security Configuration
# ========================================================
# SECRET_KEY: Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# Must be 32+ characters. REQUIRED for production.
SECRET_KEY=replace-with-your-secret-key-minimum-32-characters

# FLASK_ENV: 'production' or 'development'
FLASK_ENV=development

# STAFF_LOGIN_PATH: secret URL for the staff/admin login form.
# Students are never shown this link; /login and /admin/login are decoys.
# Pick something unguessable, e.g. /staff-<random-words-or-token>.
# Default (if left unset): /staff-portal
STAFF_LOGIN_PATH=/staff-portal

# ========================================================
# Database Configuration
# ========================================================
# SQLite (default): Leave DATABASE_URL empty, uses classroom.db
# PostgreSQL/Supabase: Set DATABASE_URL below
# Format: postgresql://user:password@host:port/database
DATABASE_URL=

# ========================================================
# Email Configuration (SMTP)
# ========================================================
# For announcements and notifications
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-specific-password
EMAIL_FROM=your-email@gmail.com

# Gmail Setup Instructions:
# 1. Enable 2-Factor Authentication on your Google account
# 2. Go to https://myaccount.google.com/apppasswords
# 3. Select "Mail" and "Windows Computer"
# 4. Copy the generated password here (16 characters with spaces)

# Alternative SMTP Providers:
# Mailtrap: SMTP_SERVER=smtp.mailtrap.io (free tier available)
# SendGrid: SMTP_SERVER=smtp.sendgrid.net
# AWS SES: SMTP_SERVER=email-smtp.REGION.amazonaws.com

# ========================================================
# Mistral AI (Admin AI Assistant + quiz generation)
# ========================================================
# Get a free API key at https://console.mistral.ai (API Keys section).
# MISTRAL_MODEL options:
#   mistral-large-latest   -> smartest (needs paid credits / billing)
#   mistral-small-latest   -> fast and cheap, still strong
#   open-mistral-nemo      -> free-tier friendly
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-large-latest

# ========================================================
# Cloud Storage (Optional)
# ========================================================
# For cloud uploads instead of local storage
# Leave empty to use local uploads/ directory
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_BUCKET=attachments

# ========================================================
# Application Settings
# ========================================================
# Session timeout
SESSION_TIMEOUT_MINUTES=30
SESSION_REFRESH_EACH_REQUEST=True

# File uploads
MAX_CONTENT_LENGTH=16777216
ALLOWED_EXTENSIONS=pdf,doc,docx,xls,xlsx,txt,png,jpg,jpeg,gif

# Logging
LOG_LEVEL=INFO
DEBUG=False
TESTING=False

# Public URL for QR codes and links
PUBLIC_URL=https://your-public-tunnel-url.example.com

# ========================================================
# QUICK START
# ========================================================
# 1. Copy this file:  cp .env.example .env
# 2. Edit .env and set your values
# 3. Generate SECRET_KEY:  python -c "import secrets; print(secrets.token_hex(32))"
# 4. Configure SMTP (Gmail recommended, see instructions above)
# 5. Run: python app.py
# 6. Test at: http://localhost:5000

# ========================================================
# PRODUCTION CHECKLIST
# ========================================================
# Before deploying:
# [ ] Generate NEW SECRET_KEY
# [ ] Set FLASK_ENV=production
# [ ] Configure PostgreSQL (set DATABASE_URL)
# [ ] Configure production email (SMTP)
# [ ] Set DEBUG=False
# [ ] Use HTTPS only
# [ ] Change default admin password
# [ ] Test all authentication flows
# [ ] Run: pip-audit (check for vulnerabilities)
# [ ] Enable monitoring and logging
# [ ] Backup database
# [ ] Test disaster recovery

# ========================================================
# EXAMPLE: Gmail Setup for Development
# ========================================================
# FLASK_ENV=development
# SECRET_KEY=dev-123456789abcdef123456789abcdef12
# SMTP_SERVER=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=teacher@gmail.com
# SMTP_PASSWORD=xxxx xxxx xxxx xxxx
# PUBLIC_URL=http://localhost:5000

# ========================================================
# EXAMPLE: Production with PostgreSQL
# ========================================================
# FLASK_ENV=production
# SECRET_KEY=prod-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# DATABASE_URL=postgresql://admin:securepass@db.company.com:5432/classroom
# SMTP_SERVER=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=classroom@company.com
# SMTP_PASSWORD=xxxx xxxx xxxx xxxx
# PUBLIC_URL=https://classroom.company.com
# SUPABASE_URL=https://your-supabase-project.supabase.co
# SUPABASE_KEY=your-supabase-key
# SUPABASE_BUCKET=attachments